<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer definition, built with wixl from msitools so the MSI can be
  produced on macOS alongside the .app.

  The GUIDs below are fixed on purpose. UpgradeCode identifies the product for
  ever — changing it makes a new version install alongside the old one instead
  of replacing it. The component GUIDs are stable for the same reason.

  Only one payload: LiveCapGo.exe. The Windows build links no external library —
  libsoxr is replaced by the pure-Go filter, and miniaudio and GLFW compile into
  the binary — so there is nothing else to install.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="@APP_NAME@"
           Language="1033"
           Version="@VERSION@"
           Manufacturer="@MANUFACTURER@"
           UpgradeCode="20018B9A-C93E-4523-8FF5-8AF597C3FF4F">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Description="@APP_NAME@ @VERSION@"
             Comments="Real-time speech translation captions" />

    <Media Id="1" Cabinet="livecap.cab" EmbedCab="yes" />

    <!-- Replace an older install rather than sitting beside it. -->
    <Upgrade Id="20018B9A-C93E-4523-8FF5-8AF597C3FF4F">
      <UpgradeVersion Minimum="0.0.0"
                      Maximum="@VERSION@"
                      IncludeMinimum="yes"
                      IncludeMaximum="no"
                      Property="OLDERVERSIONBEINGUPGRADED" />
    </Upgrade>
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="@APP_NAME@">
          <Component Id="MainExecutable"
                     Guid="D139CE9B-AF98-416F-8F1A-89BA9C1CF317"
                     Win64="yes">
            <File Id="LiveCapGoExe"
                  Name="@APP_NAME@.exe"
                  Source="@STAGE@/@APP_NAME@.exe"
                  KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="@APP_NAME@">
          <Component Id="StartMenuShortcut"
                     Guid="2DC6776F-7914-4AAA-969F-334D11670B2C"
                     Win64="yes">
            <Shortcut Id="StartMenuLink"
                      Name="@APP_NAME@"
                      Description="Real-time speech translation captions"
                      Target="[INSTALLDIR]@APP_NAME@.exe"
                      WorkingDirectory="INSTALLDIR" />
            <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />
            <!-- A per-user shortcut needs a per-user key path. -->
            <RegistryValue Root="HKCU"
                           Key="Software\@MANUFACTURER_KEY@\@APP_NAME@"
                           Name="installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop">
        <Component Id="DesktopShortcut"
                   Guid="3D5221FF-7F54-4360-942C-7DED7EC29C92"
                   Win64="yes">
          <Shortcut Id="DesktopLink"
                    Name="@APP_NAME@"
                    Description="Real-time speech translation captions"
                    Target="[INSTALLDIR]@APP_NAME@.exe"
                    WorkingDirectory="INSTALLDIR" />
          <RegistryValue Root="HKCU"
                         Key="Software\@MANUFACTURER_KEY@\@APP_NAME@"
                         Name="desktop"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="@APP_NAME@" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
