# Copy this file to .env and fill in your key.
#
#   cp .env.example .env
#
# .env is gitignored. This file is committed, so it must never contain a real
# key. Leaving the placeholder below unchanged counts as "no key at all".
#
# Get a key at https://aistudio.google.com/apikey — billing is mandatory,
# gemini-3.5-live-translate-preview is not on the free tier.

GEMINI_API_KEY=your-key-here

# GOOGLE_API_KEY is accepted as a fallback if GEMINI_API_KEY is unset.
# GOOGLE_API_KEY=

# Set to 1 for debug logging. Key values are never logged, only variable names.
# LIVECAP_DEBUG=1
